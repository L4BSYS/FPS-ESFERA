{
  "rules": {
    "messages": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null && (!newData.exists() || (newData.hasChildren(['username','timestamp','text']) && newData.child('username').isString() && newData.child('username').val().length <= 32 && newData.child('timestamp').isNumber() && newData.child('text').isString() && newData.child('text').val().length <= 500))",
        ".validate": "!newData.exists() || (newData.hasChildren(['username','timestamp','text']) && newData.child('username').isString() && newData.child('username').val().length <= 32 && newData.child('timestamp').isNumber() && newData.child('text').isString() && newData.child('text').val().length <= 500)",
        "username": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      "$roomId": {
        ".write": "auth != null && (root.child('rooms/' + $roomId + '/meta/host').val() == auth.uid || (root.child('rooms/' + $roomId + '/meta').exists() && root.child('rooms/' + $roomId + '/meta/updatedAt').val() < now - 900000))",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() ? newData.child('host').val() == auth.uid : (data.child('host').val() == auth.uid || (newData.child('host').val() == auth.uid && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists() && data.child('hostSeen').val() < now - 15000 && newData.child('hostEpoch').val() > data.child('hostEpoch').val())))",
          ".validate": "newData.hasChildren(['v','host','hostEpoch','hostSeen','levelId','seed','mode','status','maxPlayers','playerCount','createdAt','updatedAt']) && (newData.child('host').val() == auth.uid || (data.exists() && data.child('host').val() == auth.uid))",
          "v": { ".validate": "newData.isNumber() && newData.val() == 1" },
          "host": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "hostEpoch": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "hostSeen": { ".validate": "newData.isNumber()" },
          "levelId": { ".validate": "newData.isString() && newData.val().matches(/^(playground|tutorial|mundo-1|mundo-2|mundo-3)$/)" },
          "seed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295" },
          "mode": { ".validate": "newData.val() == 'coop'" },
          "status": { ".validate": "newData.val() == 'lobby' || newData.val() == 'playing' || newData.val() == 'ended'" },
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5" },
          "playerCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "players": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms/' + $roomId + '/playersInfo/' + $uid).exists()",
            ".validate": "newData.hasChildren(['0','1','2','3','4','5','6'])",
            "0": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "1": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
            "2": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 100000" },
            "3": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
            "4": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15" },
            "5": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "6": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "$other": { ".validate": false }
          }
        },
        "playersInfo": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms/' + $roomId + '/meta').exists() && (!newData.exists() || (newData.child('code').isString() && root.child('roomCodes/' + newData.child('code').val() + '/roomId').val() == $roomId && (data.exists() || root.child('rooms/' + $roomId + '/meta/status').val() != 'ended')))",
            ".validate": "newData.hasChildren(['n','c','ready','lastSeen','code'])",
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "c": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "ready": { ".validate": "newData.isBoolean()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "down": { ".validate": "newData.isBoolean()" },
            "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)" },
            "$other": { ".validate": false }
          }
        },
        "state": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".validate": "newData.hasChildren(['t','hp','w','left','timer','updatedAt'])",
          "t": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "w": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "left": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "timer": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "bases": {
            "$owner": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }
          },
          "$other": { ".validate": false }
        },
        "build": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$key": {
            ".validate": "newData.hasChildren(['x','y','z','rm']) && (newData.child('rm').val() == true || (newData.child('t').exists() && newData.child('t').isString()))",
            "x": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "rm": { ".validate": "newData.isBoolean()" },
            "t": { ".validate": "newData.isString() && newData.val().matches(/^(wood|stone|metal)$/)" },
            "r": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "actions": {
          ".read": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$uid": {
            "$seq": {
              ".write": "auth != null && auth.uid == $uid && $seq.matches(/^[0-7]$/) && root.child('rooms/' + $roomId + '/playersInfo/' + $uid).exists()",
              ".validate": "((newData.child('k').val() == 'revive' && newData.hasChildren(['k','target','at'])) || (newData.child('k').val() == 'build' && newData.hasChildren(['k','d','at']) && newData.child('d').hasChildren(['x','y','z','rm']) && (newData.child('d/rm').val() == true || (newData.child('d/t').exists() && newData.child('d/t').isString()))) || (newData.child('k').val() == 'bench' && newData.hasChildren(['k','d','at']) && newData.child('d').hasChildren(['x','y','z','rm'])))",
              "k": { ".validate": "newData.isString() && (newData.val() == 'revive' || newData.val() == 'build' || newData.val() == 'bench')" },
              "at": { ".validate": "newData.isNumber()" },
              "s": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "target": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "d": {
                ".validate": "newData.hasChildren(['x','y','z','rm'])",
                "x": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
                "y": { ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000" },
                "z": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
                "rm": { ".validate": "newData.isBoolean()" },
                "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
                "t": { ".validate": "newData.isString() && newData.val().matches(/^(wood|stone|metal)$/)" },
                "r": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
                "$other": { ".validate": false }
              },
              "$other": { ".validate": false }
            }
          }
        },
        "events": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".indexOn": "at",
          "$eventId": {
            ".validate": "newData.hasChildren(['k','at']) && ((newData.child('k').val() == 'wave' && newData.hasChildren(['k','w','at'])) || (newData.child('k').val() == 'base' && newData.hasChildren(['k','hp','at'])) || (newData.child('k').val() == 'revive' && newData.hasChildren(['k','target','at'])) || (newData.child('k').val() == 'bench' && newData.hasChildren(['k','x','y','z','rm','at'])))",
            "k": { ".validate": "newData.isString() && (newData.val() == 'wave' || newData.val() == 'base' || newData.val() == 'revive' || newData.val() == 'bench')" },
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "w": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "rm": { ".validate": "newData.isBoolean()" },
            "owner": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "target": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "bases": {
              "$owner": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }
            },
            "$other": { ".validate": false }
          }
        },
        "world": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".validate": "newData.hasChildren(['v','levelId','seed','mode','createdAt'])",
          "v": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "levelId": { ".validate": "newData.isString() && newData.val().matches(/^(playground|tutorial|mundo-1|mundo-2|mundo-3)$/)" },
          "seed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295" },
          "mode": { ".validate": "newData.val() == 'coop'" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "savedAt": { ".validate": "newData.isNumber()" },
          "snapshot": {
            ".validate": "newData.hasChildren(['v'])",
            "v": { ".validate": "newData.isNumber() && newData.val() >= 1" },
            "blocks": { ".validate": "true" },
            "items": { ".validate": "true" },
            "nodes": { ".validate": "true" },
            "benches": { ".validate": "true" },
            "stairs": { ".validate": "true" },
            "doors": { ".validate": "true" },
            "containers": { ".validate": "true" },
            "spawns": { ".validate": "true" },
            "zones": { ".validate": "true" },
            "totems": { ".validate": "true" },
            "statics": { ".validate": "true" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "chat": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$msg": {
            ".write": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists() && newData.child('u').val() == auth.uid",
            ".validate": "newData.hasChildren(['u','n','m','t'])",
            "u": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 140" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 3600000" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['roomId','host','createdAt'])",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() == auth.uid && root.child('rooms/' + newData.child('roomId').val() + '/meta/host').val() == auth.uid) || (data.exists() && (root.child('rooms/' + data.child('roomId').val() + '/meta/host').val() == auth.uid || !root.child('rooms/' + data.child('roomId').val()).exists())))",
        "roomId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "host": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
