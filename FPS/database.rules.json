{
  "rules": {
    "messages": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null && (!newData.exists() || (newData.hasChildren(['username','timestamp','text']) && newData.child('username').isString() && newData.child('username').val().length <= 32 && newData.child('timestamp').isNumber() && newData.child('text').isString() && newData.child('text').val().length <= 500))",
        ".validate": "!newData.exists() || (newData.hasChildren(['username','timestamp','text']) && newData.child('username').isString() && newData.child('username').val().length <= 32 && newData.child('timestamp').isNumber() && newData.child('text').isString() && newData.child('text').val().length <= 500)",
        "username": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      "$roomId": {
        ".write": "auth != null && (root.child('rooms/' + $roomId + '/meta/host').val() == auth.uid || (root.child('rooms/' + $roomId + '/meta').exists() && root.child('rooms/' + $roomId + '/meta/updatedAt').val() < now - 900000))",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() ? newData.child('host').val() == auth.uid : (data.child('host').val() == auth.uid || (newData.child('host').val() == auth.uid && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists() && data.child('hostSeen').val() < now - 15000 && newData.child('hostEpoch').val() > data.child('hostEpoch').val())))",
          ".validate": "newData.hasChildren(['v','host','hostEpoch','hostSeen','levelId','seed','mode','status','maxPlayers','playerCount','createdAt','updatedAt']) && (newData.child('host').val() == auth.uid || (data.exists() && data.child('host').val() == auth.uid))",
          "v": { ".validate": "newData.isNumber() && (newData.val() == 1 || newData.val() == 2)" },
          "host": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "hostEpoch": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "hostSeen": { ".validate": "newData.isNumber()" },
          "levelId": { ".validate": "newData.isString() && newData.val().matches(/^(playground|tutorial|mundo-1|mundo-2|mundo-3)$/)" },
          "seed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295" },
          "mode": { ".validate": "newData.val() == 'coop'" },
          "status": { ".validate": "newData.val() == 'lobby' || newData.val() == 'playing' || newData.val() == 'ended'" },
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 5" },
          "playerCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "players": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms/' + $roomId + '/playersInfo/' + $uid).exists()",
            ".validate": "newData.hasChildren(['0','1','2','3','4','5','6'])",
            "0": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "1": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
            "2": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 100000" },
            "3": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
            "4": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15" },
            "5": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "6": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "$other": { ".validate": false }
          }
        },
        "playersInfo": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms/' + $roomId + '/meta').exists() && (!newData.exists() || (newData.child('code').isString() && root.child('roomCodes/' + newData.child('code').val() + '/roomId').val() == $roomId && (data.exists() || root.child('rooms/' + $roomId + '/meta/status').val() != 'ended')))",
            ".validate": "newData.hasChildren(['n','c','ready','lastSeen','code'])",
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "c": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "ready": { ".validate": "newData.isBoolean()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "down": { ".validate": "newData.isBoolean()" },
            "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)" },
            "$other": { ".validate": false }
          }
        },
        "state": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".validate": "newData.hasChildren(['t','hp','w','left','timer','updatedAt'])",
          "t": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "w": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "left": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "timer": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "bases": {
            "$owner": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }
          },
          "$other": { ".validate": false }
        },
        "build": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$key": {
            ".validate": "newData.hasChildren(['x','y','z','rm']) && (newData.child('rm').val() == true || (newData.child('t').exists() && newData.child('t').isString()))",
            "x": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "rm": { ".validate": "newData.isBoolean()" },
            "t": { ".validate": "newData.isString() && newData.val().matches(/^(wood|stone|metal)$/)" },
            "r": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "mobs": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$eid": {
            ".validate": "newData.hasChildren(['0','1','2','3','4'])",
            "0": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
            "1": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
            "2": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15" },
            "3": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "4": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 16" },
            "5": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 100000" },
            "$other": { ".validate": false }
          }
        },
        "actions": {
          ".read": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$uid": {
            "$seq": {
              ".write": "auth != null && auth.uid == $uid && $seq.matches(/^[0-9]$|^1[01]$/) && root.child('rooms/' + $roomId + '/playersInfo/' + $uid).exists()",
              ".validate": "newData.hasChildren(['k','at']) && newData.child('at').isNumber() && ((newData.child('k').val() == 'revive' && newData.hasChildren(['k','target','at']) && newData.child('target').isString() && newData.child('target').val().length <= 128) || (newData.child('k').val() == 'build' && newData.hasChildren(['k','d','at']) && newData.child('d').hasChildren(['x','y','z','rm']) && (newData.child('d/rm').val() == true || (newData.child('d/t').exists() && newData.child('d/t').isString() && newData.child('d/t').val().matches(/^(wood|stone|metal)$/)))) || (newData.child('k').val() == 'bench' && newData.hasChildren(['k','d','at']) && newData.child('d').hasChildren(['x','y','z','rm'])) || (newData.child('k').val() == 'shoot' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['x','y','z','dx','dy','dz','pitch','seq'])) || (newData.child('k').val() == 'atk' && newData.hasChildren(['k','d','at','s']) && (newData.child('d/eid').exists() || newData.child('d/targetUid').exists())) || (newData.child('k').val() == 'harvest' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['nid','tool']) && newData.child('d/nid').isString() && newData.child('d/nid').val().length <= 64 && newData.child('d/tool').val().matches(/^(axe|pickaxe)$/)) || (newData.child('k').val() == 'loot' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['iid']) && newData.child('d/iid').isString() && newData.child('d/iid').val().length <= 64) || (newData.child('k').val() == 'drop' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['id','q','x','y','z']) && newData.child('d/q').isNumber() && newData.child('d/q').val() >= 1 && newData.child('d/q').val() <= 999) || (newData.child('k').val() == 'chest' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['cid','op']) && (newData.child('d/op').val() == 'take' || newData.child('d/op').val() == 'put')) || (newData.child('k').val() == 'door' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['did','open']) && newData.child('d/open').isBoolean()) || (newData.child('k').val() == 'struct' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['t','x','y','z','rm']) && newData.child('d/t').val().matches(/^(stairs|door)$/)) || (newData.child('k').val() == 'craft' && newData.hasChildren(['k','d','at','s']) && newData.child('d').hasChildren(['op','x','y','z']) && newData.child('d/op').val().matches(/^(ammo|consume)$/)))",
              "k": { ".validate": "newData.isString() && (newData.val() == 'revive' || newData.val() == 'build' || newData.val() == 'bench' || newData.val() == 'shoot' || newData.val() == 'atk' || newData.val() == 'harvest' || newData.val() == 'loot' || newData.val() == 'drop' || newData.val() == 'chest' || newData.val() == 'door' || newData.val() == 'struct' || newData.val() == 'craft')" },
              "at": { ".validate": "newData.isNumber()" },
              "s": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "target": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "d": {
                "x": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
                "y": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
                "z": { ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000" },
                "rm": { ".validate": "newData.isBoolean()" },
                "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
                "t": { ".validate": "newData.isString() && newData.val().length <= 32" },
                "r": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
                "dx": { ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 2000" },
                "dy": { ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 2000" },
                "dz": { ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 2000" },
                "pitch": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
                "seq": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "nid": { ".validate": "newData.isString() && newData.val().length <= 64" },
                "iid": { ".validate": "newData.isString() && newData.val().length <= 64" },
                "cid": { ".validate": "newData.isString() && newData.val().length <= 64" },
                "did": { ".validate": "newData.isString() && newData.val().length <= 64" },
                "eid": { ".validate": "newData.isString() && newData.val().length <= 64" },
                "targetUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
                "tool": { ".validate": "newData.isString() && newData.val().matches(/^(axe|pickaxe|hands|hammer)$/)" },
                "op": { ".validate": "newData.val() == 'take' || newData.val() == 'put' || newData.val() == 'ammo' || newData.val() == 'consume'" },
                "open": { ".validate": "newData.isBoolean()" },
                "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
                "q": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
                "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64" },
                "melee": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" }
              },
              "$other": { ".validate": false }
            }
          }
        },
        "events": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".indexOn": "at",
          "$eventId": {
            ".validate": "newData.hasChildren(['k','at']) && ((newData.child('k').val() == 'wave' && newData.hasChildren(['k','w','at'])) || (newData.child('k').val() == 'base' && newData.hasChildren(['k','hp','at'])) || (newData.child('k').val() == 'revive' && newData.hasChildren(['k','target','at'])) || (newData.child('k').val() == 'bench' && newData.hasChildren(['k','x','y','z','rm','at'])) || (newData.child('k').val() == 'hurt' && newData.hasChildren(['k','target','hp','at']) && newData.child('target').isString() && newData.child('hp').isNumber()) || (newData.child('k').val() == 'loot' && newData.hasChildren(['k','iid','at'])) || (newData.child('k').val() == 'node' && newData.hasChildren(['k','nid','at'])) || (newData.child('k').val() == 'fx' && newData.hasChildren(['k','fk','x','y','z','at'])) || (newData.child('k').val() == 'nack' && newData.hasChildren(['k','s','at','target'])) || (newData.child('k').val() == 'chest' && newData.hasChildren(['k','cid','at'])) || (newData.child('k').val() == 'door' && newData.hasChildren(['k','did','open','at'])) || (newData.child('k').val() == 'struct' && newData.hasChildren(['k','t','x','y','z','rm','at'])) || (newData.child('k').val() == 'mobDeath' && newData.hasChildren(['k','eid','at'])) || (newData.child('k').val() == 'npcBatch' && newData.hasChildren(['k','t','p','at']) && newData.child('p').isString() && newData.child('p').val().length <= 900))",
            "k": { ".validate": "newData.isString() && (newData.val() == 'wave' || newData.val() == 'base' || newData.val() == 'revive' || newData.val() == 'bench' || newData.val() == 'hurt' || newData.val() == 'loot' || newData.val() == 'node' || newData.val() == 'fx' || newData.val() == 'nack' || newData.val() == 'chest' || newData.val() == 'door' || newData.val() == 'struct' || newData.val() == 'mobDeath' || newData.val() == 'npcBatch')" },
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "w": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000" },
            "z": { ".validate": "newData.isNumber() && newData.val() >= -10000 && newData.val() <= 10000" },
            "rm": { ".validate": "newData.isBoolean()" },
            "owner": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "target": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "src": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "down": { ".validate": "newData.isBoolean()" },
            "nid": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "iid": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "cid": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "did": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "eid": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "fk": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "s": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "reason": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
            "q": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
            "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64" },
            "op": { ".validate": "newData.val() == 'take' || newData.val() == 'put'" },
            "open": { ".validate": "newData.isBoolean()" },
            "t": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "r": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
            "p": { ".validate": "newData.isString() && newData.val().length <= 900" },
            "bases": {
              "$owner": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" }
            },
            "gained": {
              ".validate": "newData.hasChildren(['res','q'])",
              "res": { ".validate": "newData.isString() && newData.val().matches(/^(wood|stone|metal)$/)" },
              "q": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
              "$other": { ".validate": false }
            }
          }
        },
        "world": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          ".validate": "newData.hasChildren(['v','levelId','seed','mode','createdAt'])",
          "v": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "levelId": { ".validate": "newData.isString() && newData.val().matches(/^(playground|tutorial|mundo-1|mundo-2|mundo-3)$/)" },
          "seed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295" },
          "mode": { ".validate": "newData.val() == 'coop'" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "savedAt": { ".validate": "newData.isNumber()" },
          "snapshot": {
            ".validate": "newData.hasChildren(['v'])",
            "v": { ".validate": "newData.isNumber() && newData.val() >= 1" },
            "blocks": { ".validate": "true" },
            "items": { ".validate": "true" },
            "nodes": { ".validate": "true" },
            "benches": { ".validate": "true" },
            "stairs": { ".validate": "true" },
            "doors": { ".validate": "true" },
            "containers": { ".validate": "true" },
            "spawns": { ".validate": "true" },
            "zones": { ".validate": "true" },
            "totems": { ".validate": "true" },
            "statics": { ".validate": "true" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "chat": {
          ".read": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists()",
          ".write": "auth != null && auth.uid == root.child('rooms/' + $roomId + '/meta/host').val()",
          "$msg": {
            ".write": "auth != null && root.child('rooms/' + $roomId + '/playersInfo/' + auth.uid).exists() && newData.child('u').val() == auth.uid",
            ".validate": "newData.hasChildren(['u','n','m','t'])",
            "u": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "n": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "m": { ".validate": "newData.isString() && newData.val().length <= 140" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 3600000" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['roomId','host','createdAt'])",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() == auth.uid && root.child('rooms/' + newData.child('roomId').val() + '/meta/host').val() == auth.uid) || (data.exists() && (root.child('rooms/' + data.child('roomId').val() + '/meta/host').val() == auth.uid || !root.child('rooms/' + data.child('roomId').val()).exists())))",
        "roomId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "host": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
